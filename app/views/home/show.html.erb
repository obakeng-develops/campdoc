<% content_for :title, "Campsend · Send files and track delivery" %>
<% content_for :description, "Send files free with an expiring link. Track when your delivery is first opened or downloaded." %>
<% content_for :head do %>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Campsend",
      "url": "<%= root_url %>",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "Send files with expiring links and track when each delivery is opened or downloaded.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  </script>
<% end %>

<div class="landing-page">
  <%= render "marketing_header" %>

  <main>
    <section class="landing-hero">
      <div class="landing-hero__copy">
        <h1>The simple way to send files.</h1>
        <p class="landing-lede">Add a note, email an expiring link, and see when the delivery is first opened or downloaded.</p>
        <div class="landing-actions">
          <%= link_to "Send files", new_session_path(intent: "send"), class: "button button--primary landing-primary-action" %>
          <span>Links expire after 30 days</span>
        </div>
      </div>

      <div class="handoff-scene" data-controller="handoff" role="img" aria-label="Campsend sending a contract to Sam, who opens and downloads it">
        <div class="mini-app" aria-hidden="true">
          <div class="mini-app__bar">
            <%= image_tag "campsend-icon.png", class: "mini-app__mark", alt: "" %>
            <span>Campsend</span>
          </div>

          <div class="mini-composer">
            <div class="mini-composer__heading"><span>New delivery</span><strong>Choose files to send.</strong></div>
            <div class="mini-composer__body">
              <div class="mini-dropzone">
                <div class="mini-drop-prompt"><span>↑</span><strong>Drop files here</strong></div>
                <div class="mini-selected-file">
                  <span class="mini-file-icon">PDF</span>
                  <div><strong>Final contract.pdf</strong><small>2.4 MB</small></div>
                </div>
              </div>
              <div class="mini-fields">
                <label>Who’s this for?<span class="mini-field-value mini-field-value--recipient">sam@example.com</span></label>
                <label>Add a note<span class="mini-field-value mini-field-value--note">Here’s the final contract. Let me know what you think.</span></label>
                <span class="mini-send-button">Send file</span>
              </div>
            </div>
          </div>

          <div class="mini-delivery">
            <div class="mini-delivery__intro"><small>Delivery for Sam</small><strong>You received a file.</strong><p>“Here’s the final contract. Let me know what you think.”</p></div>
            <div class="mini-delivery__file">
              <span class="mini-file-icon mini-file-icon--large">PDF</span>
              <div><strong>Final contract.pdf</strong><small>2.4 MB</small></div>
              <span class="mini-download-button">Download</span>
            </div>
          </div>
        </div>
        <div class="handoff-delivered" aria-hidden="true"><span>✓</span> Sam downloaded it</div>
      </div>
    </section>

    <section class="landing-manifesto">
      <div class="manifesto-heading">
        <h2>Why I built Campsend</h2>
      </div>
      <article class="manifesto-letter">
        <p>Hello,</p>
        <p>Sending files doesn’t need to be this difficult.</p>
        <p>I got tired of switching between Dropbox, Google Drive, and WeTransfer whenever I needed to send finished work to one person. Their pricing is all over the place too.</p>
        <p>I wanted a smaller tool for delivering work.</p>
        <p>With Campsend, you choose files, add a note, and enter the recipient’s email address. They get a link that expires after 30 days. You can see when the delivery is first opened or downloaded.</p>
        <p>Campsend also keeps the files you send, so you can use them again without uploading them again.</p>
        <p>That’s why I’m building Campsend.</p>
        <address class="manifesto-signature">
          <strong>Obakeng Mosadi</strong>
          <%= mail_to "mosadiobakeng7@gmail.com" %>
        </address>
      </article>
    </section>

    <section class="landing-ledger" data-controller="handoff">
      <div class="landing-ledger__copy">
        <p class="eyebrow">Delivery activity</p>
        <h2>See what happened.</h2>
        <p>Campsend records when a delivery is first opened and when any file is first downloaded.</p>
      </div>
      <div class="ledger-card" aria-label="Delivery activity for Final contract.pdf">
        <div class="ledger-file-row">
          <div class="ledger-file-icon">PDF</div>
          <div><strong>Final contract.pdf</strong><span>Sent to sam@example.com</span></div>
        </div>
        <ol class="landing-event-list">
          <li class="complete"><i></i><strong>Sent</strong><span>9:42 AM</span></li>
          <li class="complete"><i></i><strong>Opened</strong><span>10:07 AM</span></li>
          <li class="complete"><i></i><strong>Downloaded</strong><span>10:08 AM</span></li>
        </ol>
      </div>
    </section>

    <section class="landing-cta">
      <div>
        <p class="eyebrow">Your next delivery</p>
        <h2>Choose files to send.</h2>
      </div>
      <%= link_to "Send files", new_session_path(intent: "send"), class: "button button--primary landing-primary-action" %>
    </section>
  </main>

  <%= render "marketing_footer" %>
</div>
