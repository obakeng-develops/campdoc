<% content_for :title, "Your sends · Campdoc" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">Your sends</p>
    <h1>What you’ve shared</h1>
  </div>
  <%= link_to new_send_path, class: "button button--primary" do %>
    <span aria-hidden="true">＋</span> Send files
  <% end %>
</div>

<% if @sends.any? %>
  <div class="send-stream">
    <% @sends.each do |send_record| %>
      <%= link_to send_path(send_record), class: "send-card" do %>
        <div class="send-card__files <%= "send-card__files--stacked" if send_record.files.size > 1 %>">
          <% primary_file = send_record.files.first %>
          <% if previewable_image?(primary_file) %>
            <%= image_tag send_file_path(send_record, primary_file), alt: "", class: "send-card__preview" %>
          <% else %>
            <div class="file-glyph"><span><%= file_kind(primary_file) %></span></div>
          <% end %>
          <% if send_record.files.size > 1 %>
            <span class="file-count">+<%= send_record.files.size - 1 %></span>
          <% end %>
        </div>

        <div class="send-card__body">
          <div class="send-card__topline">
            <strong><%= primary_file.filename %></strong>
            <time datetime="<%= send_record.created_at.iso8601 %>"><%= time_ago_in_words(send_record.created_at) %> ago</time>
          </div>
          <% if send_record.message.present? %>
            <p class="send-card__message"><%= truncate(send_record.message, length: 120) %></p>
          <% end %>
          <div class="relationship-row">
            <span class="avatar" aria-hidden="true"><%= send_record.recipient_name.first %></span>
            <span><%= status_sentence(send_record) %></span>
            <span class="status-dot status-dot--<%= send_record.status %>" aria-hidden="true"></span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <section class="empty-state">
    <div class="empty-file" aria-hidden="true">
      <span class="empty-file__fold"></span>
      <span class="empty-file__line"></span>
      <span class="empty-file__line empty-file__line--short"></span>
    </div>
    <h2>Your first Send starts with a file.</h2>
    <p>Share the work, add a little context, and we’ll keep track of the handoff.</p>
    <%= link_to "Choose something to send", new_send_path, class: "button button--primary" %>
  </section>
<% end %>
