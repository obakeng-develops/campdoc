APP_HOST=campdoc.example.com
MAIL_FROM=Campdoc <hello@campdoc.example.com>
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# local or s3
ACTIVE_STORAGE_SERVICE=local

# Required when ACTIVE_STORAGE_SERVICE=s3. Works with R2, S3, MinIO, B2, and Wasabi.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
# Required when direct-upload URLs use a different origin than STORAGE_ENDPOINT.
STORAGE_BROWSER_ORIGIN=
