<div style="text-align: center;">
  <%= image_tag "campsend-icon.png", alt: "Campsend", width: 48, height: 50, style: "display: block; margin: 0 auto 1rem;" %>
</div>

<h1 style="font-size: 1.25rem; font-weight: 600; margin: 0 0 0.75rem;">Sign in to Campsend</h1>

<p style="color: #525252; margin: 0 0 1.5rem;">Click the button below to sign in. This single-use link expires in 15 minutes.</p>

<p style="margin: 0 0 1.5rem;">
  <%= link_to "Sign in to Campsend", sign_in_url(public_id: @login_token.public_id, anchor: "token=#{@token}"), style: "background-color: #ff591e; border-radius: 8px; color: #ffffff; display: inline-block; font-weight: 600; padding: 0.75rem 1.25rem; text-decoration: none;" %>
</p>

<p style="color: #737373; font-size: 0.875rem; margin: 0;">
  Didn’t request this? You can safely ignore this email.
</p>
