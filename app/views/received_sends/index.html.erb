<% content_for :title, "Shared with me · Campdoc" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">Incoming</p>
    <h1>Shared with me</h1>
  </div>
</div>

<% if @sends.any? %>
  <div class="send-stream">
    <% @sends.each do |send_record| %>
      <%= link_to delivery_path(public_id: send_record.public_id), class: "send-card" do %>
        <div class="send-card__files <%= "send-card__files--stacked" if send_record.files.size > 1 %>">
          <% primary_file = send_record.files.first %>
          <% if previewable_image?(primary_file) %>
            <%= image_tag delivery_file_path(public_id: send_record.public_id, id: primary_file.id), alt: "", class: "send-card__preview" %>
          <% else %>
            <div class="file-glyph"><span><%= file_kind(primary_file) %></span></div>
          <% end %>
          <% if send_record.files.size > 1 %>
            <span class="file-count">+<%= send_record.files.size - 1 %></span>
          <% end %>
        </div>

        <div class="send-card__body">
          <div class="send-card__topline">
            <strong><%= primary_file.filename %></strong>
            <time datetime="<%= send_record.created_at.iso8601 %>"><%= time_ago_in_words(send_record.created_at) %> ago</time>
          </div>
          <% if send_record.message.present? %>
            <p class="send-card__message"><%= truncate(send_record.message, length: 120) %></p>
          <% end %>
          <div class="relationship-row">
            <span class="avatar" aria-hidden="true"><%= send_record.user.email_address.first %></span>
            <span>From <%= send_record.user.email_address %></span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <section class="empty-state">
    <div class="empty-file" aria-hidden="true">
      <span class="empty-file__fold"></span>
      <span class="empty-file__line"></span>
      <span class="empty-file__line empty-file__line--short"></span>
    </div>
    <h2>Nothing has been shared with you yet.</h2>
    <p>Active deliveries sent to <%= current_user.email_address %> will appear here automatically.</p>
  </section>
<% end %>
