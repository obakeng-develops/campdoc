<div class="plan-usage">
  <div class="plan-usage__heading">
    <strong><%= current_user.plan.titleize %></strong>
    <span><%= number_to_human_size(storage_used) %> of <%= number_to_human_size(current_user.storage_limit) %></span>
  </div>
  <meter value="<%= storage_used %>" max="<%= current_user.storage_limit %>" aria-label="Storage used"><%= number_to_percentage(storage_used.fdiv(current_user.storage_limit) * 100, precision: 0) %></meter>
  <% if current_user.monthly_send_limit %>
    <span><%= sends_used %> of <%= current_user.monthly_send_limit %> deliveries sent this month</span>
  <% end %>
</div>
