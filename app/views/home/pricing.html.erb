<% content_for :title, "Pricing · Campsend" %>
<% content_for :head do %>
  <meta name="description" content="Managed Campsend includes a Free plan. Pro and Studio plans are planned.">
<% end %>

<div class="landing-page pricing-page">
  <%= render "marketing_header" %>

  <main>
    <header class="pricing-heading">
      <p class="eyebrow">Pricing</p>
      <h1>Plans for keeping and sending files.</h1>
      <p>The managed Free plan is available now. Pro and Studio are planned.</p>
    </header>

    <div class="pricing-grid">
      <article class="pricing-card">
        <div class="plan-label plan-label--available">Available now</div>
        <div class="pricing-card__heading">
          <div>
            <h2>Free</h2>
            <p>For sending a few deliveries each month.</p>
          </div>
          <p class="plan-price"><strong>$0</strong><span>per month</span></p>
        </div>
        <ul class="plan-features">
          <li>5 deliveries each month</li>
          <li>2 GB storage</li>
          <li>Expiring, revocable delivery links</li>
          <li>First-open and first-download status</li>
        </ul>
        <%= link_to "Start free", new_session_path(intent: "send"), class: "button button--wide" %>
      </article>

      <article class="pricing-card pricing-card--featured">
        <div class="plan-label">Planned</div>
        <div class="pricing-card__heading">
          <div>
            <h2>Pro</h2>
            <p>For people who send work often.</p>
          </div>
          <p class="plan-price"><strong>$9</strong><span>per month</span></p>
        </div>
        <ul class="plan-features">
          <li>Unlimited deliveries</li>
          <li>250 GB storage</li>
          <li>Your logo and colors on delivery pages</li>
        </ul>
        <p class="plan-availability">Billing is not available yet.</p>
      </article>

      <article class="pricing-card">
        <div class="plan-label">Planned</div>
        <div class="pricing-card__heading">
          <div>
            <h2>Studio</h2>
            <p>For small teams that send together.</p>
          </div>
          <p class="plan-price"><strong>$49</strong><span>per month</span></p>
        </div>
        <ul class="plan-features">
          <li>Everything in Pro</li>
          <li>3 TB shared storage</li>
          <li>Unlimited members</li>
          <li>Shared delivery history</li>
          <li>Shared contacts</li>
        </ul>
        <p class="plan-availability">Team features are not available yet.</p>
      </article>
    </div>

    <section class="pricing-note">
      <h2>Use managed Campsend or run it yourself.</h2>
      <p>Self-hosted installations have no Campsend storage or delivery limits. You provide the server, storage, and email service.</p>
      <%= link_to "Self-host Campsend", "https://github.com/obakeng-develops/campsend", class: "button button--primary landing-primary-action" %>
    </section>
  </main>

  <%= render "marketing_footer" %>
</div>
